// Haat data model. All money columns are integer paise.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isBlocked    Boolean  @default(false)
  avatarUrl    String?
  coinBalance  Int      @default(0)
  referralCode String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  addresses         Address[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orders            Order[]
  coinTransactions  CoinTransaction[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  notifications     Notification[]
  referralsGiven    Referral[]         @relation("ReferrerReferrals")
  referralReceived  Referral?          @relation("RefereeReferral")

  @@index([role, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  /// Set only when the token was rotated (not on logout/block), so a racing refresh can be told apart from theft.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  highlights  String[]
  /// Array of { label: string, value: string }
  specs       Json     @default("[]")
  tags        String[]
  categoryId  String
  brandId     String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Denormalised for listing filters/sorting; kept in sync by the products service.
  minPrice        Int   @default(0)
  minMrp          Int   @default(0)
  discountPercent Int   @default(0)
  ratingAvg       Float @default(0)
  ratingCount     Int   @default(0)
  soldCount       Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId, isActive])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, soldCount])
  @@index([isActive, minPrice])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  label             String   @default("Default")
  /// e.g. { "size": "M", "color": "Red" }
  attributes        Json     @default("{}")
  mrp               Int
  price             Int
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  branchStock    BranchVariantStock[]

  @@index([productId])
  @@index([stock])
}

enum StockMovementType {
  IN
  OUT
  SET
  SALE
  CANCEL
  RETURN
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  type        StockMovementType
  /// Signed delta applied to stock.
  quantity    Int
  stockAfter  Int
  reason      String?
  orderId     String?
  createdById String?
  createdAt   DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model SearchTerm {
  term      String   @id
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count])
}

// ───────────────────────────── Shopping ─────────────────────────────

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

// ───────────────────────────── Promotions ─────────────────────────────

enum CouponType {
  PERCENT
  FLAT
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String     @default("")
  type           CouponType
  /// Percent (1-100) for PERCENT, paise for FLAT.
  value          Int
  maxDiscount    Int?
  minOrderValue  Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  perUserLimit   Int        @default(1)
  usedCount      Int        @default(0)
  firstOrderOnly Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  discount  Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

enum CoinTransactionType {
  EARN
  REDEEM
  REFUND
  REVERSE
  ADJUST
  BONUS
}

model CoinTransaction {
  id           String              @id @default(cuid())
  userId       String
  type         CoinTransactionType
  /// Signed: positive credits, negative debits. 1 coin = ₹1.
  amount       Int
  balanceAfter Int
  orderId      String?
  note         String?
  createdAt    DateTime            @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkType  BannerLinkType  @default(NONE)
  linkValue String?
  placement BannerPlacement @default(HOME_CAROUSEL)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

enum BannerLinkType {
  NONE
  PRODUCT
  CATEGORY
  SEARCH
  URL
}

enum BannerPlacement {
  HOME_CAROUSEL
  HOME_STRIP
}

// ───────────────────────────── Orders & delivery ─────────────────────────────

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  RETURN_REJECTED
}

enum PaymentMethod {
  COD
  UPI_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  /// Branch that fulfils this order (resolved at checkout; null for legacy orders).
  branchId      String?
  status        OrderStatus   @default(PLACED)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  /// Snapshot of the delivery address at order time.
  shippingAddress Json

  itemsMrp       Int
  itemsTotal     Int
  couponId       String?
  couponCode     String?
  couponDiscount Int     @default(0)
  coinsUsed      Int     @default(0)
  deliveryFee    Int     @default(0)
  payable        Int
  coinsToEarn    Int     @default(0)
  coinsEarned    Int     @default(0)

  riderId         String?
  riderAssignedAt DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  returnReason    String?
  customerNote    String?
  adminNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon           Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  rider            Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  history          OrderStatusHistory[]
  couponRedemption CouponRedemption?
  coinTransactions CoinTransaction[]
  notificationLogs NotificationLog[]
  referral         Referral?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([riderId])
  @@index([branchId])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  productName  String
  variantLabel String
  sku          String
  imageUrl     String?
  mrp          Int
  price        Int
  quantity     Int
  lineTotal    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  actorRole String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum VehicleType {
  BIKE
  SCOOTER
  BICYCLE
  CAR
  VAN
  OTHER
}

model Rider {
  id            String      @id @default(cuid())
  name          String
  phone         String      @unique
  whatsapp      String?
  email         String?
  vehicleType   VehicleType @default(BIKE)
  vehicleNumber String?
  idProofType   String?
  idProofNumber String?
  address       String?
  notes         String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders   Order[]
  branches BranchRider[]

  @@index([isActive])
}

// ───────────────────────────── Engagement ─────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String?
  rating    Int
  title     String?
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, isHidden, createdAt])
}

enum NotificationType {
  ORDER
  PROMO
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum RecipientType {
  CUSTOMER
  RIDER
  ADMIN
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model NotificationLog {
  id            String              @id @default(cuid())
  channel       NotificationChannel
  recipientType RecipientType
  recipient     String
  template      String
  subject       String?
  body          String
  status        DeliveryStatus
  error         String?
  providerRef   String?
  orderId       String?
  createdAt     DateTime            @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REVERSED
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  refereeId     String         @unique
  status        ReferralStatus @default(PENDING)
  orderId       String?        @unique
  referrerCoins Int            @default(50)
  refereeCoins  Int            @default(25)
  completedAt   DateTime?
  reversedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  referrer User   @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User   @relation("RefereeReferral", fields: [refereeId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([refereeId])
  @@index([orderId])
}

model Settings {
  id                    Int      @id @default(1)
  storeName             String   @default("Haat")
  supportEmail          String   @default("support@haat.local")
  supportPhone          String   @default("")
  adminEmail            String   @default("")
  adminWhatsapp         String   @default("")
  deliveryFee           Int      @default(4000)
  freeDeliveryThreshold Int      @default(49900)
  coinEarnPer100        Int      @default(2)
  coinMaxRedeemPercent  Int      @default(20)
  returnWindowDays      Int      @default(7)
  codEnabled            Boolean  @default(true)
  upiOnDeliveryEnabled  Boolean  @default(true)
  referralEnabled       Boolean  @default(true)
  referralReferrerCoins Int      @default(50)
  referralRefereeCoins  Int      @default(25)
  updatedAt             DateTime @updatedAt
}

// ───────────────────────────── Branches ─────────────────────────────

model Branch {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  address          String
  city             String
  state            String
  pincode          String
  /// Decimal degrees (WGS-84)
  lat              Float
  /// Decimal degrees (WGS-84)
  lng              Float
  deliveryRadiusKm Float    @default(5)
  phone            String?
  email            String?
  isActive         Boolean  @default(true)
  /// Operational on/off switch controlled by the admin.
  isOnline         Boolean  @default(true)
  /// Shown to the customer when isOnline = false, e.g. "Back at 9 AM".
  offlineMessage   String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branchStock BranchVariantStock[]
  orders      Order[]
  riders      BranchRider[]
  statusLogs  BranchStatusLog[]

  @@index([isActive, isOnline])
  @@index([lat, lng])
}

model BranchVariantStock {
  id                String   @id @default(cuid())
  branchId          String
  variantId         String
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  /// Admin can hide a variant from this branch's catalog without removing stock.
  isAvailable       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockMovements BranchStockMovement[]

  @@unique([branchId, variantId])
  @@index([branchId, stock])
  @@index([variantId])
}

model BranchStockMovement {
  id            String            @id @default(cuid())
  branchStockId String
  /// Reuses the global enum: IN | OUT | SET | SALE | CANCEL | RETURN
  type          StockMovementType
  /// Signed delta; negative removes stock.
  quantity      Int
  stockAfter    Int
  reason        String?
  orderId       String?
  createdById   String?
  createdAt     DateTime          @default(now())

  branchStock BranchVariantStock @relation(fields: [branchStockId], references: [id], onDelete: Cascade)

  @@index([branchStockId, createdAt])
  @@index([orderId])
}

/// Many-to-many: riders assigned to branches.
model BranchRider {
  branchId String
  riderId  String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rider  Rider  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@id([branchId, riderId])
}

model BranchStatusLog {
  id        String   @id @default(cuid())
  branchId  String
  isOnline  Boolean
  reason    String?
  actorId   String?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
}

