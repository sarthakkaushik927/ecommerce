{
  "expo": {
    "name": "Haat",
    "slug": "haat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haat.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC727",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.haat.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFC727"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Haat uses the microphone so you can search for products by voice.",
          "speechRecognitionPermission": "Haat uses speech recognition to turn what you say into a product search.",
          "androidSpeechServicePackages": ["com.google.android.as", "com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "scheme": "haat",
    "experiments": {
      "typedRoutes": true
    }
  }
}
